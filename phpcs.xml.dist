<?xml version="1.0"?>
<ruleset name="newsapi-pull">
    <description>PSR-12 for the plugin, its tests and examples.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>newsapi-pull.php</file>
    <file>bootstrap.php</file>
    <file>uninstall.php</file>
    <exclude-pattern>tests/stubs/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <!-- Admin markup is easier to read on one line. -->
        <exclude name="Generic.Files.LineLength"/>
        <!-- WP-CLI subcommand "list" must be a method named list_. -->
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>newsapi-pull.php</exclude-pattern>
        <exclude-pattern>bootstrap.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/phpstan-constants.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
    </rule>
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="eval" value="null"/>
                <element key="exec" value="null"/>
                <element key="shell_exec" value="null"/>
                <element key="system" value="null"/>
                <element key="passthru" value="null"/>
                <element key="proc_open" value="null"/>
                <element key="popen" value="null"/>
            </property>
        </properties>
    </rule>
    <rule ref="Generic.PHP.NoSilencedErrors"/>
</ruleset>
