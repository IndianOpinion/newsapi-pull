{
    "name": "indianopinion/newsapi-pull",
    "description": "WordPress plugin that pulls headlines from NewsAPI.org into drafts, with filters, URL-hash de-duplication, source attribution and a daily quota meter.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "news", "newsapi", "drafts", "deduplication", "quota"],
    "homepage": "https://github.com/IndianOpinion/newsapi-pull",
    "support": {
        "issues": "https://github.com/IndianOpinion/newsapi-pull/issues",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "ext-intl": "Converts internationalised host names to their ASCII form before keying."
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\NewsApiPull\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\NewsApiPull\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
